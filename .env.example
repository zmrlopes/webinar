# Sala partilhada de Zoom — só no servidor. Nunca no browser, nunca no repositório.
# Copia este ficheiro para .env e preenche com a chave real (não versionar .env).
SALA_BASE_URL=https://sessoes.joanapatrick.com
SALA_API_KEY=

# Base de dados (Fase 2 em diante).
DATABASE_URL=postgres://user:password@localhost:5432/webinar

# Painel de administração (/admin) — Basic Auth. Sem ADMIN_PASSWORD, o
# painel fica inacessível (falha fechado, não há password por omissão).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Protege os endpoints /api/cron/* contra chamadas de quem não tem o segredo.
CRON_SECRET=

# Envio real de emails (Brevo). Sem BREVO_API_KEY, os emails só ficam
# registados no log (nada é enviado) — seguro para desenvolvimento.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=geral@viajareviver.net
BREVO_SENDER_NAME=Viajar é Viver

# Lista da Brevo onde cada inscrito é sincronizado (Contacts > Lists).
BREVO_LISTA_INSCRITOS_ID=22

# Opcional, só para testes locais (aponta para um mock em vez da Brevo real).
# BREVO_API_BASE_URL=http://localhost:8794

# Domínio público do site, usado para montar o link de entrada rastreável
# (/api/entrar/<id>) nos emails de confirmação/lembrete. Sem esta variável,
# usa o domínio principal atual.
# SITE_BASE_URL=https://webinar.viajareviver.net
