# Sala partilhada de Zoom — só no servidor. Nunca no browser, nunca no repositório.
# Copia este ficheiro para .env e preenche com a chave real (não versionar .env).
SALA_BASE_URL=https://sessoes.joanapatrick.com
SALA_API_KEY=

# Base de dados (Fase 2 em diante).
DATABASE_URL=postgres://user:password@localhost:5432/webinar

# Painel de administração (/admin) — Basic Auth. Sem ADMIN_PASSWORD, o
# painel fica inacessível (falha fechado, não há password por omissão).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Protege os endpoints /api/cron/* contra chamadas de quem não tem o segredo.
CRON_SECRET=
