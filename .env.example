# Copia este ficheiro para .env, na raiz do projeto, e preenche com os
# valores reais (não versionar .env — já está no .gitignore). Os scripts
# em scripts/ (migrar, processar-presencas, etc.) carregam este .env
# automaticamente ao arrancar — não é preciso definir estas variáveis à
# mão no terminal antes de cada comando, nem depois de reiniciar o PC.
#
# Sala partilhada de Zoom — só no servidor. Nunca no browser, nunca no repositório.
SALA_BASE_URL=https://sessoes.joanapatrick.com
SALA_API_KEY=

# Base de dados (Fase 2 em diante).
DATABASE_URL=postgres://user:password@localhost:5432/webinar

# Painel de administração (/admin) — Basic Auth. Sem ADMIN_PASSWORD, o
# painel fica inacessível (falha fechado, não há password por omissão).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Protege os endpoints /api/cron/* contra chamadas de quem não tem o segredo.
CRON_SECRET=

# Envio real de emails (Brevo). Sem BREVO_API_KEY, os emails só ficam
# registados no log (nada é enviado) — seguro para desenvolvimento.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=geral@viajareviver.net
BREVO_SENDER_NAME=Viajar é Viver

# Lista da Brevo onde cada inscrito é sincronizado (Contacts > Lists).
BREVO_LISTA_INSCRITOS_ID=22

# Opcional, só para testes locais (aponta para um mock em vez da Brevo real).
# BREVO_API_BASE_URL=http://localhost:8794

# Domínio público do site, usado para montar o link de entrada rastreável
# (/api/entrar/<id>) nos emails de confirmação/lembrete. Sem esta variável,
# usa o domínio principal atual.
# SITE_BASE_URL=https://webinar.viajareviver.net

# Envio de emails pela ActiveCampaign. Com estas três definidas, é por aqui
# que sai tudo (exceto emails com anexos, que vão sempre pela Brevo — a AC
# não sabe anexar ficheiros gerados na hora, como os QR codes do evento).
# Sem elas, cai na Brevo sozinha. A AC não tem "enviar este email agora":
# o AUTOMATION_ID é o de uma automação de um passo só que lê o assunto e o
# corpo de dois campos do contacto — ver ActiveCampaignEmailSender.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_AUTOMATION_ID=

# Lista "Consultores ativos" na AC. Na ActiveCampaign o cancelamento de
# subscrição é por lista: quem se descansou de uma lista antiga de leads
# deixa de receber os avisos das automações. Ter os consultores numa lista
# própria é o que faz os avisos operacionais voltarem a chegar. Sem esta
# variável, usa o valor por omissão em src/lib/activecampaign.ts.
# ACTIVECAMPAIGN_LISTA_CONSULTORES=24

# Notificações push da app (Web Push/VAPID). Gera o par de chaves com
# `npx web-push generate-vapid-keys`. Sem elas, as notificações não saem —
# silenciosamente, porque são opcionais por cima do email. A pública vai
# para o browser (daí o NEXT_PUBLIC_), a privada nunca sai do servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:geral@viajareviver.net

# Assistente de objeções (/consultor/objecoes) — sem esta chave, essa
# funcionalidade devolve erro; o resto do sistema não depende dela.
ANTHROPIC_API_KEY=

# Dashboard de negócio embebido no /admin (Looker Studio, Metabase, etc.).
# Sem esta variável, a página explica como a definir em vez de rebentar.
# NEXT_PUBLIC_DASHBOARD_NEGOCIO_URL=
